# frozen_string_literal: true
# Git operations across all repos.

class Tasks
  @@repos  ||= %w[robot_lab robot_lab-a2a robot_lab-audit robot_lab-document_store robot_lab-durable robot_lab-ractor robot_lab-rails robot_lab-to robot_lab-web].freeze
  @@github ||= "git@github.com:MadBomber".freeze

  desc "Clone all repos (safe to run on an existing workspace)"
  def clone
    @@repos.each do |repo|
      if Dir.exist?(repo)
        printf "\e[1;33m%-32s\e[0m already exists — skipping\n", repo
      else
        printf "\e[1;32m%-32s\e[0m cloning...\n", repo
        sh "git clone \"#{@@github}/#{repo}.git\""
      end
    end
  end

  desc "Fetch from origin in all repos"
  def fetch
    @@repos.each do |repo|
      printf "\e[1;32m%-32s\e[0m", repo
      result = `git -C "#{repo}" fetch --quiet 2>&1`
      puts $?.success? ? "fetched" : "FAILED: #{result.strip}"
    end
  end

  desc "Pull (fast-forward only) in all repos"
  def pull
    @@repos.each do |repo|
      puts "\n\e[1;32m── #{repo}\e[0m"
      system("git -C \"#{repo}\" pull --ff-only")
    end
  end

  desc "Push each repo's current branch to its remote"
  def push
    @@repos.each do |repo|
      printf "\e[1;32m%-32s\e[0m", repo
      result = `git -C "#{repo}" push 2>&1`
      if $?.success?
        puts result.include?("up-to-date") ? "up-to-date" : "\e[1;36mpushed\e[0m"
      else
        puts "\e[1;31mFAILED\e[0m: #{result.strip.lines.last&.strip}"
      end
    end
  end

  desc "each CMD", "Run a shell command in every repo (e.g. asgard each 'git log -1')"
  def each(cmd)
    @@repos.each do |repo|
      puts "\n\e[1;32m── #{repo}\e[0m"
      system("cd \"#{repo}\" && #{cmd}")
    end
  end

  desc "Show current branch in all repos"
  def branches
    @@repos.each do |repo|
      branch = `git -C "#{repo}" rev-parse --abbrev-ref HEAD 2>/dev/null`.strip
      status = `git -C "#{repo}" status --short 2>/dev/null`.strip
      dirty  = status.empty? ? "" : " \e[1;33m(dirty)\e[0m"
      printf "  %-32s %s%s\n", repo, branch, dirty
    end
  end
end
