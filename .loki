# frozen_string_literal: true
# RobotLab workspace — entry point. Run `asgard help` for available tasks.
#
# Pulls in the shared cross-project toolkit from projects/workspace/ (repo lists,
# @@core, git/quality/gems/sync/overview tasks). ws_repos is loaded first so
# @@core/@@repos are defined before the other modules reference them.

import_up "workspace/ws_repos.loki"
import_up "workspace/*.loki"

class Tasks
  helper(:workspace_version) do
    file = Dir.glob("#{@@core}/lib/**/version.rb").first
    file ? File.read(file)[/VERSION\s*=\s*['"]([^'"]+)['"]/, 1] : "?.?.?" rescue "?.?.?"
  end

  header "RobotLab Project Workspace v#{workspace_version} — #{@@gems.size} gems + #{(@@repos - @@gems).size} app(s)"
  footer "Run `asgard help <task>` for usage details"

  default_task :check

  desc "aia [ARGS]", "Run aia/bin/aia with pass-through arguments (e.g. asgard aia --chat)"
  def aia(*args)
    sh "BUNDLE_GEMFILE=aia/Gemfile.local aia/bin/aia #{args.join(' ')}"
  end
end
