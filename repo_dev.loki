# frozen_string_literal: true
# Project-level component tasks for the RobotLab gems.
#
# Imports the shared MadBomber-level tasks (DRY: one source of truth in
# ../dev/) and is itself imported by each gem's .loki via `import_up`.
# `import` resolves relative to THIS file, so the ../dev paths are stable
# regardless of which gem directory asgard runs from.
#
# Add RobotLab-project-specific component overrides below the imports; a
# task defined here (or in a gem's own .loki) overrides the shared one.

import "../dev/quality.loki"
import "../dev/gem_tasks.loki"
